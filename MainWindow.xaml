<Window x:Class="GumAdministration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GumAdministration"
        xmlns:vm="clr-namespace:GumAdministration.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    
    <Grid>
        <!-- Потом тут будет авторизация. Пока бюджета не хватило -->
        
        <DataGrid ItemsSource="{Binding FilteredClients}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <!-- Столбец "Имя" с поиском -->
                <DataGridTemplateColumn Header="Имя">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBox 
                                Text="{Binding DataContext.SearchFirstName, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Width="120"
                                TextChanged="{Binding Path=OnSearchTextChanged}"
                            />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FirstName}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ~1~ Столбец "Фамилия" с поиском @1@ -->
                <!-- <DataGridTemplateColumn Header="Фамилия"> -->
                <!--     <DataGridTemplateColumn.HeaderTemplate> -->
                <!--         <DataTemplate> -->
                <!--             <TextBox Text="{Binding DataContext.SearchLastName, RelativeSource={RelativeSource AncestorType=DataGrid}}"  -->
                <!--                      Width="120"  -->
                <!--                      TextChanged="OnSearchTextChanged" /> -->
                <!--         </DataTemplate> -->
                <!--     </DataGridTemplateColumn.HeaderTemplate> -->
                <!--     <DataGridTemplateColumn.CellTemplate> -->
                <!--         <DataTemplate> -->
                <!--             <TextBlock Text="{Binding LastName}" /> -->
                <!--         </DataTemplate> -->
                <!--     </DataGridTemplateColumn.CellTemplate> -->
                <!-- </DataGridTemplateColumn> -->
            </DataGrid.Columns>
        </DataGrid>
        
    </Grid>
</Window>
